# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shared-session SSO across *.merqo.io kits — leave unset in dev/preview
# (they don't run on merqo.io; setting this there breaks login instead of
# just failing to share it). Set to .merqo.io in Vercel Production only.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Merqo dashboard metrics endpoint — bearer secret for GET /api/merqo/metrics.
# Server-only. Must equal the value stored in merqo's products.metrics_secret.
MERQO_METRICS_SECRET=

# Guards POST /api/merqo/vendor-provision (merqo hub's one-click "Activate
# qkit" button) — a write capability, deliberately a DIFFERENT secret from
# MERQO_METRICS_SECRET above so a leak of one doesn't grant the other.
MERQO_PROVISION_SECRET=

# loopkit deployment URL — used by the order-status page to check whether a
# vendor has qkit-earn enabled and to build the "Earn a stamp" link. If
# unset, the order-status page fails closed (link never shows).
NEXT_PUBLIC_LOOPKIT_URL=

# paykit deployment URL — base for the /api/v1/* checkout API qkit's payment
# flow now calls (vendor PayNow config, checkout, claim, confirm). Falls back
# to https://paykit-sg.vercel.app if unset. See src/lib/paykit/client.ts.
NEXT_PUBLIC_PAYKIT_URL=

# Bearer secret for paykit's /api/v1/* API — sent as
# `Authorization: Bearer qkit:<secret>`. Must equal the value paykit's
# kit_api_keys table stores for kit_slug='qkit' (minted via paykit's
# scripts/create-kit-key.mjs). Server-only. NOT YET MINTED for production —
# leave unset; src/lib/paykit/client.ts degrades to a clear per-request error
# (not a build failure) when this is empty.
PAYKIT_KIT_SECRET=

# Telegram vendor order alerts — a vendor links their Telegram once (deep-link
# QR in dashboard settings) and gets a message on every new order, a redundant
# channel alongside the live order board. TELEGRAM_BOT_TOKEN: create a bot via
# @BotFather, copy the token it gives you. TELEGRAM_BOT_USERNAME: that same
# bot's @username (no leading @), used to build the t.me deep link.
# TELEGRAM_WEBHOOK_SECRET: any random string you choose yourself — configured
# on Telegram's side via the bot's setWebhook call (see AGENTS.md's deploy
# notes; this repo doesn't automate that one-time call). All server-only —
# unset locally is fine, sendTelegramMessage/the webhook route both no-op or
# fail closed rather than break anything else.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google OAuth (read by the Supabase CLI when running `supabase start`, NOT by Next).
# Create an OAuth 2.0 Web client in Google Cloud Console; authorized redirect URI:
#   local: http://127.0.0.1:54321/auth/v1/callback
#   prod:  https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
