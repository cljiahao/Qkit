# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Reverse proxy trust — set to VPC CIDR (e.g. 10.0.0.0/8) or * when behind ALB → Traefik; leave empty for local dev
TRUST_PROXY=

# Merqo dashboard metrics endpoint — bearer secret for GET /api/merqo/metrics.
# Server-only. Must equal the value stored in merqo's products.metrics_secret.
MERQO_METRICS_SECRET=

# loopkit deployment URL — used by the order-status page to check whether a
# vendor has qkit-earn enabled and to build the "Earn a stamp" link. If
# unset, the order-status page fails closed (link never shows).
NEXT_PUBLIC_LOOPKIT_URL=

# Google OAuth (read by the Supabase CLI when running `supabase start`, NOT by Next).
# Create an OAuth 2.0 Web client in Google Cloud Console; authorized redirect URI:
#   local: http://127.0.0.1:54321/auth/v1/callback
#   prod:  https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
